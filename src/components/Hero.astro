---
import { Image } from "astro:assets";
import { profile } from "../data/resume";
import headshot from "../assets/headshot.png";
import Icon from "./Icon.astro";
---

<section id="top" class="flex flex-col-reverse gap-8 pt-16 pb-16 sm:flex-row sm:items-center sm:justify-between sm:pt-28">
  <div>
    <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-accent uppercase">{profile.eyebrow}</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">Hi, I'm {profile.firstName}.</h1>
    <p class="mt-5 max-w-xl text-lg text-zinc-600 sm:text-xl">
      {profile.tagline} Experience at Amazon, Bloomberg, Snap, and Forkcast.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${profile.email}`}
        data-copy-email={profile.email}
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-dark"
      >
        <Icon name="mail" class="size-4" /> <span data-label>Get in touch</span>
      </a>
      {profile.resumeUrl && (
        <a
          href={profile.resumeUrl}
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-zinc-900"
        >
          <Icon name="download" class="size-4" /> Resume
        </a>
      )}
      <div class="ml-1 flex items-center gap-4 text-zinc-500">
        <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="transition-colors hover:text-accent">
          <Icon name="linkedin" class="size-6" />
        </a>
        <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="transition-colors hover:text-accent">
          <Icon name="github" class="size-6" />
        </a>
      </div>
    </div>
  </div>

  <Image
    src={headshot}
    alt={`Photo of ${profile.name}`}
    width={320}
    height={320}
    loading="eager"
    class="size-28 shrink-0 rounded-full object-cover ring-1 ring-zinc-200 sm:size-44"
  />
</section>
