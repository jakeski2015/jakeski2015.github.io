---
import { profile } from "../data/resume";
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-10 border-b border-zinc-100 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
    <a href="#top" class="font-semibold tracking-tight">{profile.name}</a>
    <ul class="flex gap-5 text-sm text-zinc-600 sm:gap-7">
      {links.map((l) => (
        <li class={l.href === "#skills" ? "hidden sm:block" : ""}>
          <a href={l.href} class="transition-colors hover:text-accent">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
