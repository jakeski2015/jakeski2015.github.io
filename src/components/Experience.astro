---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { experience } from "../data/resume";
---

<Section id="experience" title="Experience">
  <ol class="space-y-12">
    {experience.map((job) => (
      <li>
        <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
          <h3 class="text-lg font-semibold">
            {job.url ? (
              <a href={job.url} target="_blank" rel="noopener" class="group inline-flex items-center gap-1 hover:text-accent">
                {job.company}
                <Icon name="external" class="size-4 text-zinc-400 transition-colors group-hover:text-accent" />
              </a>
            ) : (
              job.company
            )}
          </h3>
          <span class="text-sm text-zinc-500 tabular-nums">{job.dates}</span>
        </div>
        <p class="text-sm text-zinc-500">{job.role} · {job.location}</p>

        <ul class="mt-3 space-y-1.5 text-zinc-700">
          {job.bullets.map((b) => (
            <li class="relative pl-4 before:absolute before:top-[0.6em] before:left-0 before:size-1.5 before:rounded-full before:bg-zinc-300">
              {b}
            </li>
          ))}
        </ul>

        <ul class="mt-3 flex flex-wrap gap-2">
          {job.tech.map((t) => (
            <li class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600">{t}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
